{
  "name": "ziraat-homepage-local-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local reproduction of the public Ｚiraat Baank English homepage",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "dev": "node --env-file=.env --watch server.mjs",
    "build": "node scripts/build.mjs && node scripts/build-subpages.mjs",
    "prepare:menu-assets": "node scripts/prepare-menu-assets.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "gsap": "^3.15.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
